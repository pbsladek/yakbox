{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/voice-quality-v1.schema.json",
  "title": "yakbox synthesized voice quality qualification",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "yakbox_version",
    "timestamp",
    "audition_report",
    "expected_text_sha256",
    "expected_token_count",
    "baseline_voices",
    "model",
    "alignment_fingerprint",
    "scope",
    "accepted",
    "baseline_count",
    "high_quality_count",
    "suspect_count",
    "suspect_voices",
    "thresholds",
    "voices"
  ],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/voice-quality-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "audition_report": {"type": "string"},
    "expected_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_token_count": {"type": "integer", "minimum": 1},
    "baseline_voices": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "model": {"type": "string", "minLength": 1},
    "alignment_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"const": "automated_intelligibility_and_signal_quality"},
    "accepted": {"type": "boolean"},
    "baseline_count": {"type": "integer", "minimum": 2},
    "high_quality_count": {"type": "integer", "minimum": 0},
    "suspect_count": {"type": "integer", "minimum": 0},
    "suspect_voices": {"type": "array", "items": {"type": "string"}},
    "thresholds": {"type": "object"},
    "voices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "voice",
          "audio",
          "audio_sha256",
          "baseline",
          "status",
          "accepted",
          "reason_codes",
          "metrics",
          "prompt_sensitivity",
          "consensus_reason_codes"
        ],
        "properties": {
          "voice": {"type": "string", "minLength": 1},
          "audio": {"type": "string"},
          "audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "baseline": {"type": "boolean"},
          "status": {"enum": ["baseline", "baseline_invalid", "high_quality", "suspect"]},
          "accepted": {"type": "boolean"},
          "reason_codes": {"type": "array", "items": {"type": "string"}},
          "metrics": {"type": "object"},
          "prompt_sensitivity": {"type": "string"},
          "consensus_reason_codes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
