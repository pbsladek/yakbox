{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/whisper-join-inspection-v1.schema.json",
  "title": "yakbox Whisper join inspection",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "audio", "audio_duration_seconds", "window_seconds", "alignment_window_count", "coalesced_join_count", "accepted", "failed_join_count", "joins"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/whisper-join-inspection-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "audio": {"type": "string"},
    "audio_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "window_seconds": {"type": "number", "exclusiveMinimum": 0},
    "alignment_window_count": {"type": "integer", "minimum": 1},
    "coalesced_join_count": {"type": "integer", "minimum": 0},
    "accepted": {"type": "boolean"},
    "failed_join_count": {"type": "integer", "minimum": 0},
    "scope": {
      "type": "object",
      "required": ["incremental", "join_indices", "sources"],
      "properties": {
        "incremental": {"type": "boolean"},
        "join_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["join_index", "before_chunk_id", "after_chunk_id", "before", "after"],
            "properties": {
              "join_index": {"type": "integer", "minimum": 0},
              "before_chunk_id": {"type": "string"},
              "after_chunk_id": {"type": "string"},
              "before": {"$ref": "#/$defs/sourceLocation"},
              "after": {"$ref": "#/$defs/sourceLocation"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "joins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "at_seconds", "boundary", "window_start_seconds", "window_end_seconds", "expected_before_sha256", "expected_after_sha256", "accepted", "reason_codes", "diagnostic_reason_codes", "recognized_tokens", "signal", "confidence_profile", "alignment"]
      }
    }
  },
  "$defs": {
    "sourceLocation": {
      "type": "object",
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
