{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/audiobook-cleanup-report-v1.schema.json",
  "title": "yakbox cleanup report",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "cleanup_id", "restored_at", "count"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/audiobook-cleanup-report-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "cleanup_id": {"type": "string"},
    "restored_at": {"type": "string", "format": "date-time"},
    "count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
