{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/local-runtime-status-v1.schema.json",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "running", "tts_model_loaded", "whisper_models", "conditioning_cache_entries"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/local-runtime-status-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string"},
    "running": {"type": "boolean"},
    "pid": {"type": ["integer", "null"]},
    "port": {"type": ["integer", "null"]},
    "idle_timeout_seconds": {"type": ["number", "null"]},
    "idle_seconds": {"type": ["number", "null"]},
    "tts_model_loaded": {"type": "boolean"},
    "whisper_models": {"type": "integer", "minimum": 0},
    "conditioning_cache_entries": {"type": "integer", "minimum": 0},
    "resident_memory_bytes": {"type": ["integer", "null"]},
    "maximum_memory_bytes": {"type": ["integer", "null"]}
  },
  "additionalProperties": false
}
