{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-corpus-transcript-draft-v1.schema.json",
  "title": "Yakbox private corpus transcript authoring draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "fingerprint", "source_inventory_fingerprint", "review_status", "case_count", "cases"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-corpus-transcript-draft-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "fingerprint": {"$ref": "#/$defs/sha256"},
    "source_inventory_fingerprint": {"$ref": "#/$defs/sha256"},
    "review_status": {"enum": ["pending", "approved"]},
    "case_count": {"type": "integer", "minimum": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256-or-empty": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
    "agreement": {"enum": ["unanimous", "majority", "dissent", "unusable"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "text", "recognition_fingerprint", "model_fingerprint", "execution_fingerprint", "normalized_transcript_hash", "token_count", "issues"],
      "properties": {
        "engine": {"enum": ["parakeet", "qwen", "whisper"]},
        "text": {"type": "string"},
        "recognition_fingerprint": {"$ref": "#/$defs/sha256"},
        "model_fingerprint": {"$ref": "#/$defs/sha256"},
        "execution_fingerprint": {"$ref": "#/$defs/sha256"},
        "normalized_transcript_hash": {"$ref": "#/$defs/sha256"},
        "token_count": {"type": "integer", "minimum": 0},
        "issues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_window_id", "source_passage_group", "voice", "reader", "relative_audio_path", "audio_digest", "agreement", "agreement_count", "proposed_text", "accepted_text", "review_status", "reviewer_fingerprint", "candidates", "fingerprint"],
      "properties": {
        "source_window_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"},
        "source_passage_group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"},
        "voice": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
        "reader": {"type": "string", "minLength": 1},
        "relative_audio_path": {"type": "string", "minLength": 1},
        "audio_digest": {"$ref": "#/$defs/sha256"},
        "agreement": {"$ref": "#/$defs/agreement"},
        "agreement_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "proposed_text": {"type": "string"},
        "accepted_text": {"type": "string"},
        "review_status": {"enum": ["pending", "approved", "rejected"]},
        "reviewer_fingerprint": {"$ref": "#/$defs/sha256-or-empty"},
        "candidates": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/candidate"}},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
