{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/audiobook-repair-session-v1.schema.json",
  "title": "yakbox localized audio repair audition session",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "repair_id", "plan", "takes"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/audiobook-repair-session-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "repair_id": {"type": "string"},
    "report_path": {"type": "string"},
    "plan": {
      "type": "object",
      "required": ["schema_version", "target", "chapter_id", "mode", "synthesis_chunks", "affected_join_indices", "chunks"],
      "properties": {
        "schema_version": {"const": 1},
        "target": {"type": "string"},
        "chapter_id": {"type": "string"},
        "mode": {"enum": ["target-only", "context", "neighbors", "paragraph", "scene"]},
        "synthesis_chunks": {"type": "integer", "minimum": 1},
        "affected_join_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "index", "text_sha256", "characters", "speaker", "profile", "boundary", "source"],
            "properties": {
              "id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
              "index": {"type": "integer", "minimum": 0},
              "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "characters": {"type": "integer", "minimum": 1},
              "speaker": {"type": ["string", "null"]},
              "profile": {"type": ["string", "null"]},
              "boundary": {"enum": ["paragraph", "sentence", "clause", "word", "hard", "end", "explicit_pause"]},
              "source": {"$ref": "#/$defs/sourceLocation"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "takes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "accepted", "reason_codes", "audition_path", "chunks"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "accepted": {"type": "boolean"},
          "reason_codes": {"type": "array", "items": {"type": "string"}},
          "audition_path": {"type": "string"},
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sourceLocation": {
      "type": "object",
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
