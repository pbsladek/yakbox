{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-analysis-shadow-v1.schema.json",
  "title": "Yakbox speech-analysis shadow comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "audio_digest", "policy_fingerprint", "baseline", "proposed", "ground_truth", "classification"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-analysis-shadow-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "audio_digest": {"$ref": "#/$defs/sha256"},
    "policy_fingerprint": {"$ref": "#/$defs/sha256"},
    "baseline": {"$ref": "#/$defs/decision"},
    "proposed": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted", "consensus_fingerprint", "reason_codes"],
      "properties": {
        "accepted": {"type": "boolean"},
        "consensus_fingerprint": {"$ref": "#/$defs/sha256"},
        "reason_codes": {"$ref": "#/$defs/reasons"}
      }
    },
    "ground_truth": {"enum": ["known_clean", "known_defective", "unknown"]},
    "classification": {"enum": ["agreement", "additional_defect", "false_rejection_candidate", "false_acceptance_candidate", "baseline_rejection_removed"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["ambiguous_target_projection", "engine_decode_invalid", "engine_result_missing", "forced_alignment_incomplete", "invalid_engine_result", "lexical_deletion", "lexical_insertion", "lexical_substitution", "missing_required_engine", "persistent_valid_dissent", "recognition_match", "recognition_not_run", "unexpected_speech"]}},
    "baseline_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted", "reason_codes"],
      "properties": {"accepted": {"type": "boolean"}, "reason_codes": {"$ref": "#/$defs/baseline_reasons"}}
    }
  }
}
