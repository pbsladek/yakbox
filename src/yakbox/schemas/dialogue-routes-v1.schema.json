{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/dialogue-routes-v1.schema.json",
  "title": "yakbox reviewed dialogue routes",
  "type": "object",
  "required": ["$schema", "schema_version", "routes"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/dialogue-routes-v1.schema.json"},
    "schema_version": {"const": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "line", "speaker", "status"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "speaker": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "status": {"enum": ["suggested", "approved", "rejected"]},
          "enabled": {"type": "boolean", "default": true},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
