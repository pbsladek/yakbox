{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/cli-output-v1.schema.json",
  "title": "yakbox CLI envelope",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "status"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "partial_failure", "aborted", "error"]},
    "data": {"type": "object"},
    "exit_code": {"type": "integer"},
    "error": {"type": "object"}
  },
  "additionalProperties": true
}
