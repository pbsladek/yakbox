{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-human-disposition-v1.schema.json",
  "title": "Yakbox explicit human speech disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "review_id", "fingerprint", "candidate_fingerprint", "audio_digest", "spoken_text_plan_fingerprint", "expected_span_hash", "policy_fingerprint", "evidence_fingerprints", "decision", "reviewer_fingerprint", "resolved_at", "notes", "notes_hash"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-human-disposition-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "review_id": {"$ref": "#/$defs/identifier"},
    "fingerprint": {"$ref": "#/$defs/sha256"},
    "candidate_fingerprint": {"$ref": "#/$defs/sha256"},
    "audio_digest": {"$ref": "#/$defs/sha256"},
    "spoken_text_plan_fingerprint": {"$ref": "#/$defs/sha256"},
    "expected_span_hash": {"$ref": "#/$defs/sha256"},
    "policy_fingerprint": {"$ref": "#/$defs/sha256"},
    "evidence_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "decision": {"enum": ["accept", "reject"]},
    "reviewer_fingerprint": {"$ref": "#/$defs/sha256"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string", "maxLength": 4096},
    "notes_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"}
  }
}
