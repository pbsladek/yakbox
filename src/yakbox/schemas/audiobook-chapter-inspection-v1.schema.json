{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/audiobook-chapter-inspection-v1.schema.json",
  "title": "yakbox chapter inspection report",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "chapter_id", "inspections"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/audiobook-chapter-inspection-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "chapter_id": {"type": "string"},
    "inspections": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
