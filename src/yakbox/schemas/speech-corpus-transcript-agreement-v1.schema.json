{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-corpus-transcript-agreement-v1.schema.json",
  "title": "Yakbox corpus transcript agreement report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "fingerprint", "source_inventory_fingerprint", "case_count", "agreement_counts", "cases"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-corpus-transcript-agreement-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "fingerprint": {"$ref": "#/$defs/sha256"},
    "source_inventory_fingerprint": {"$ref": "#/$defs/sha256"},
    "case_count": {"type": "integer", "minimum": 1},
    "agreement_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unanimous", "majority", "dissent", "unusable"],
      "properties": {
        "unanimous": {"type": "integer", "minimum": 0},
        "majority": {"type": "integer", "minimum": 0},
        "dissent": {"type": "integer", "minimum": 0},
        "unusable": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "agreement": {"enum": ["unanimous", "majority", "dissent", "unusable"]},
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "recognition_fingerprint", "model_fingerprint", "execution_fingerprint", "normalized_transcript_hash", "token_count", "issues"],
      "properties": {
        "engine": {"enum": ["parakeet", "qwen", "whisper"]},
        "recognition_fingerprint": {"$ref": "#/$defs/sha256"},
        "model_fingerprint": {"$ref": "#/$defs/sha256"},
        "execution_fingerprint": {"$ref": "#/$defs/sha256"},
        "normalized_transcript_hash": {"$ref": "#/$defs/sha256"},
        "token_count": {"type": "integer", "minimum": 0},
        "issues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_window_id", "source_passage_group", "audio_digest", "agreement", "agreement_count", "proposed_tokens_hash", "proposed_token_count", "recognitions", "fingerprint"],
      "properties": {
        "source_window_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"},
        "source_passage_group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"},
        "audio_digest": {"$ref": "#/$defs/sha256"},
        "agreement": {"$ref": "#/$defs/agreement"},
        "agreement_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "proposed_tokens_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "proposed_token_count": {"type": "integer", "minimum": 0},
        "recognitions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/recognition"}},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
