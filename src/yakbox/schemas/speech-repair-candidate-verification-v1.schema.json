{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-repair-candidate-verification-v1.schema.json",
  "title": "Yakbox affected-scope repair candidate verification",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "fingerprint", "candidate_digest", "state", "accepted", "changed_chunks", "joins", "post_master_windows", "technical_fingerprint"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-repair-candidate-verification-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "fingerprint": {"$ref": "#/$defs/sha256"},
    "candidate_digest": {"$ref": "#/$defs/sha256"},
    "state": {"const": "repair_candidate"},
    "accepted": {"type": "boolean"},
    "changed_chunks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chunk_id", "verification_fingerprint"],
        "properties": {
          "chunk_id": {"type": "string", "minLength": 1},
          "verification_fingerprint": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "joins": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["join_id", "verification_fingerprint", "accepted"],
        "properties": {
          "join_id": {"type": "string", "minLength": 1},
          "verification_fingerprint": {"$ref": "#/$defs/sha256"},
          "accepted": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "post_master_windows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["raw_start_frame", "raw_end_frame", "start_frame", "end_frame", "repair_ids", "verification_fingerprint"],
        "properties": {
          "raw_start_frame": {"type": "integer", "minimum": 0},
          "raw_end_frame": {"type": "integer", "minimum": 1},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "repair_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "verification_fingerprint": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "technical_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
