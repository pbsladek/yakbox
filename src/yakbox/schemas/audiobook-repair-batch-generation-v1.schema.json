    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string"},
    "batch_id": {"type": "string"},
    "review_playlist": {"type": "string"},
    "sessions": {"type": "array", "minItems": 1},
    "report_path": {"type": "string"}
  },
  "additionalProperties": true
}
