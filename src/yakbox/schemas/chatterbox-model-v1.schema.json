{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/chatterbox-model-v1.schema.json",
  "title": "Recorded local Chatterbox model snapshot",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "variant", "repository", "revision", "source_url", "license", "fingerprint", "files"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/chatterbox-model-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "variant": {"enum": ["original", "turbo", "mlx-turbo"]},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://huggingface.co/"},
    "license": {"enum": ["MIT", "Apache-2.0"]},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": false
}
