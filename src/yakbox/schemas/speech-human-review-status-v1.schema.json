{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-human-review-status-v1.schema.json",
  "title": "Yakbox human speech review status",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "review_count", "reviews"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-human-review-status-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "review_count": {"type": "integer", "minimum": 0},
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "state", "candidate_fingerprint", "disposition_fingerprint", "issues"],
        "properties": {
          "review_id": {"$ref": "#/$defs/identifier"},
          "state": {"enum": ["pending", "accepted", "rejected", "stale"]},
          "candidate_fingerprint": {"$ref": "#/$defs/sha256"},
          "disposition_fingerprint": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "issues": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"}
  }
}
