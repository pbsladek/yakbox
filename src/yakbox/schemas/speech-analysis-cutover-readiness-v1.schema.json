{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-analysis-cutover-readiness-v1.schema.json",
  "title": "Yakbox speech-analysis cutover readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "fingerprint", "ready", "gates"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-analysis-cutover-readiness-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "fingerprint": {"$ref": "#/$defs/sha256"},
    "ready": {"type": "boolean"},
    "gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$"},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "evidence_fingerprints", "issues"],
      "properties": {
        "name": {"$ref": "#/$defs/issue"},
        "passed": {"type": "boolean"},
        "evidence_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/issue"}
        }
      }
    }
  }
}
