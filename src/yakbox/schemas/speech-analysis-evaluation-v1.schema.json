{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-analysis-evaluation-v1.schema.json",
  "title": "Yakbox paired speech-analysis evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "fingerprint", "corpus_fingerprint", "policy_fingerprint", "protocol_fingerprint", "case_count", "candidate_false_accept_cluster_upper_bound", "workflow_false_accept_cluster_upper_bound", "candidate_false_acceptance_safe", "workflow_false_acceptance_safe", "false_rejection_noninferior", "name_number_noninferior", "forced_boundary_improved", "crop_safety_noninferior", "mandatory_defects_rejected", "automatic_acceptances_explainable", "passed", "slices", "cases"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-analysis-evaluation-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "fingerprint": {"$ref": "#/$defs/sha256"},
    "corpus_fingerprint": {"$ref": "#/$defs/sha256"},
    "policy_fingerprint": {"$ref": "#/$defs/sha256"},
    "protocol_fingerprint": {"$ref": "#/$defs/sha256"},
    "case_count": {"type": "integer", "minimum": 1},
    "candidate_false_accept_cluster_upper_bound": {"type": "number", "minimum": 0, "maximum": 1},
    "workflow_false_accept_cluster_upper_bound": {"type": "number", "minimum": 0, "maximum": 1},
    "candidate_false_acceptance_safe": {"type": "boolean"},
    "workflow_false_acceptance_safe": {"type": "boolean"},
    "false_rejection_noninferior": {"type": "boolean"},
    "name_number_noninferior": {"type": "boolean"},
    "forced_boundary_improved": {"type": "boolean"},
    "crop_safety_noninferior": {"type": "boolean"},
    "mandatory_defects_rejected": {"type": "boolean"},
    "automatic_acceptances_explainable": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slice"}},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_nonnegative_number": {"type": ["number", "null"], "minimum": 0},
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value", "case_count", "clean_count", "defective_count", "baseline_false_accepts", "candidate_false_accepts", "workflow_false_accepts", "baseline_false_rejects", "candidate_false_rejects", "workflow_false_rejects", "additional_defects_caught", "new_false_accepts", "defect_cluster_count", "candidate_false_accept_cluster_count", "candidate_false_accept_cluster_upper_bound", "workflow_false_accept_cluster_count", "workflow_false_accept_cluster_upper_bound", "word_error_rate", "character_error_rate", "exact_token_accuracy", "baseline_name_number_accuracy", "proposed_name_number_accuracy", "hallucination_count", "baseline_boundary_median_absolute_error_ms", "proposed_boundary_median_absolute_error_ms", "baseline_boundary_p95_error_ms", "proposed_boundary_p95_error_ms", "baseline_crop_contamination_count", "proposed_crop_contamination_count", "baseline_clipped_word_count", "proposed_clipped_word_count", "cold_real_time_factor", "warm_real_time_factor", "batch_throughput_items_per_second", "peak_memory_bytes", "model_load_count", "mean_model_switch_seconds"],
      "properties": {
        "dimension": {"enum": ["all", "clip_class", "risk_class", "voice", "accent", "gender", "speaking_rate", "acoustic_condition"]},
        "value": {"type": "string", "minLength": 1},
        "case_count": {"type": "integer", "minimum": 0},
        "clean_count": {"type": "integer", "minimum": 0},
        "defective_count": {"type": "integer", "minimum": 0},
        "baseline_false_accepts": {"type": "integer", "minimum": 0},
        "candidate_false_accepts": {"type": "integer", "minimum": 0},
        "workflow_false_accepts": {"type": "integer", "minimum": 0},
        "baseline_false_rejects": {"type": "integer", "minimum": 0},
        "candidate_false_rejects": {"type": "integer", "minimum": 0},
        "workflow_false_rejects": {"type": "integer", "minimum": 0},
        "additional_defects_caught": {"type": "integer", "minimum": 0},
        "new_false_accepts": {"type": "integer", "minimum": 0},
        "defect_cluster_count": {"type": "integer", "minimum": 0},
        "candidate_false_accept_cluster_count": {"type": "integer", "minimum": 0},
        "candidate_false_accept_cluster_upper_bound": {"type": "number", "minimum": 0, "maximum": 1},
        "workflow_false_accept_cluster_count": {"type": "integer", "minimum": 0},
        "workflow_false_accept_cluster_upper_bound": {"type": "number", "minimum": 0, "maximum": 1},
        "word_error_rate": {"type": "number", "minimum": 0},
        "character_error_rate": {"type": "number", "minimum": 0},
        "exact_token_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "baseline_name_number_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "proposed_name_number_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "hallucination_count": {"type": "integer", "minimum": 0},
        "baseline_boundary_median_absolute_error_ms": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "proposed_boundary_median_absolute_error_ms": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "baseline_boundary_p95_error_ms": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "proposed_boundary_p95_error_ms": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "baseline_crop_contamination_count": {"type": "integer", "minimum": 0},
        "proposed_crop_contamination_count": {"type": "integer", "minimum": 0},
        "baseline_clipped_word_count": {"type": "integer", "minimum": 0},
        "proposed_clipped_word_count": {"type": "integer", "minimum": 0},
        "cold_real_time_factor": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "warm_real_time_factor": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "batch_throughput_items_per_second": {"$ref": "#/$defs/nullable_nonnegative_number"},
        "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "model_load_count": {"type": "integer", "minimum": 0},
        "mean_model_switch_seconds": {"$ref": "#/$defs/nullable_nonnegative_number"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "partition", "clip_class", "risk_class", "truth", "classification", "baseline_accepted", "proposed_accepted", "workflow_accepted", "consensus_fingerprint", "workflow_evidence_fingerprint"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"},
        "partition": {"enum": ["calibration", "held_out", "regression"]},
        "clip_class": {"enum": ["one_word", "short_phrase", "sentence", "join", "chapter", "repaired_region"]},
        "risk_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "truth": {"enum": ["clean", "defective"]},
        "classification": {"enum": ["agreement", "additional_defect", "false_rejection_candidate", "false_acceptance_candidate", "baseline_rejection_removed"]},
        "baseline_accepted": {"type": "boolean"},
        "proposed_accepted": {"type": "boolean"},
        "workflow_accepted": {"type": "boolean"},
        "consensus_fingerprint": {"$ref": "#/$defs/sha256"},
        "workflow_evidence_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
