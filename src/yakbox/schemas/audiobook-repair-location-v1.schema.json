{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/audiobook-repair-location-v1.schema.json",
  "title": "yakbox timestamp-to-source repair location",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "target", "chapter_id", "at_seconds", "at_frame", "chunk", "affected_join_indices"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/audiobook-repair-location-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "target": {"type": "string"},
    "chapter_id": {"type": "string"},
    "at_seconds": {"type": "number", "minimum": 0},
    "at_frame": {"type": "integer", "minimum": 0},
    "chunk": {"type": "object"},
    "affected_join_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}}
  },
  "additionalProperties": false
}
