{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-corpus-transcript-truth-v1.schema.json",
  "title": "Yakbox approved corpus transcript truth evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "fingerprint", "source_inventory_fingerprint", "draft_fingerprint", "case_count", "cases"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-corpus-transcript-truth-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "fingerprint": {"$ref": "#/$defs/sha256"},
    "source_inventory_fingerprint": {"$ref": "#/$defs/sha256"},
    "draft_fingerprint": {"$ref": "#/$defs/sha256"},
    "case_count": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_window_id", "source_passage_group", "audio_digest", "accepted_tokens_hash", "accepted_token_count", "reviewer_fingerprint", "draft_case_fingerprint", "fingerprint"],
        "properties": {
          "source_window_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"},
          "source_passage_group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"},
          "audio_digest": {"$ref": "#/$defs/sha256"},
          "accepted_tokens_hash": {"$ref": "#/$defs/sha256"},
          "accepted_token_count": {"type": "integer", "minimum": 1},
          "reviewer_fingerprint": {"$ref": "#/$defs/sha256"},
          "draft_case_fingerprint": {"$ref": "#/$defs/sha256"},
          "fingerprint": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
