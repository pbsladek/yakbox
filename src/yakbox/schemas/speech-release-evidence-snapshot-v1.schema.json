{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/speech-release-evidence-snapshot-v1.schema.json",
  "title": "Yakbox durable speech release evidence snapshot",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "release_id", "release_audio_digest", "text_plan_fingerprint", "policy_fingerprint", "calibration_fingerprint", "execution_fingerprints", "references", "decision_fingerprint", "human_disposition_fingerprint", "fingerprint"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/speech-release-evidence-snapshot-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "release_id": {"type": "string", "pattern": "^[^/\\\\]+$"},
    "release_audio_digest": {"$ref": "#/$defs/sha256"},
    "text_plan_fingerprint": {"$ref": "#/$defs/sha256"},
    "policy_fingerprint": {"$ref": "#/$defs/sha256"},
    "calibration_fingerprint": {"$ref": "#/$defs/sha256"},
    "execution_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "key", "evidence_fingerprint"],
        "properties": {
          "stage": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "key": {"$ref": "#/$defs/sha256"},
          "evidence_fingerprint": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "decision_fingerprint": {"$ref": "#/$defs/sha256"},
    "human_disposition_fingerprint": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
