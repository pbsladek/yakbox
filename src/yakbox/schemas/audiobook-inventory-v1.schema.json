{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yakbox.dev/schemas/audiobook-inventory-v1.schema.json",
  "title": "yakbox artifact inventory",
  "type": "object",
  "required": ["$schema", "schema_version", "yakbox_version", "timestamp", "root", "artifacts", "unknown_files", "total_bytes", "managed_bytes"],
  "properties": {
    "$schema": {"const": "https://yakbox.dev/schemas/audiobook-inventory-v1.schema.json"},
    "schema_version": {"const": 1},
    "yakbox_version": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "root": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "unknown_files": {"type": "array", "items": {"type": "string"}},
    "total_bytes": {"type": "integer", "minimum": 0},
    "managed_bytes": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
